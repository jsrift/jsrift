{
  "name": "jsrift",
  "version": "0.1.0",
  "description": "Scope-aware JavaScript, TypeScript and JSX deobfuscator that runs in Node and in the browser.",
  "license": "MIT",
  "author": "ravenndevv",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsrift/jsrift.git"
  },
  "homepage": "https://jsrift.github.io",
  "bugs": {
    "url": "https://github.com/jsrift/jsrift/issues"
  },
  "keywords": [
    "javascript",
    "deobfuscator",
    "deobfuscation",
    "obfuscator-io",
    "ast",
    "babel"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/worker.js"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@babel/generator": "^7.28.3",
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@babel/types": "^7.28.4",
    "@types/babel__traverse": "^7.28.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/node": "^24.5.0",
    "esbuild": "^0.27.7",
    "javascript-obfuscator": "^5.6.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
